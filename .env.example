# Server-only. Never prefix this with NEXT_PUBLIC_ or commit a real value.
OPENAI_API_KEY=

# Optional server-side model overrides.
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_REALTIME_MODEL=gpt-realtime

# Public application URL and contact address. These values are safe in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase project settings. The publishable key is intended for browsers; the
# secret key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe server credentials and recurring monthly Price IDs. Never expose these
# values in client code, logs, screenshots, Git, or chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_UNLIMITED_PRICE_ID=

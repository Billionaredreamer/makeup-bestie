default_platform(:ios)

APP_IDENTIFIER = "com.makeupbestie.app".freeze

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # APP_STORE_CONNECT_KEY_CONTENT may hold either the raw .p8 PEM text or a
    # base64 blob, so normalise it before use.
    raw_key = ENV["APP_STORE_CONNECT_KEY_CONTENT"].to_s.strip
    key_pem = raw_key.include?("BEGIN") ? raw_key : raw_key.unpack1("m")

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_pem,
      is_key_content_base64: false,
    )

    # Explicitly create/fetch the distribution certificate and the App Store
    # provisioning profile using the API key, rather than relying on
    # -allowProvisioningUpdates (which resolves to a *development* profile on a
    # runner with no signed-in Apple account).
    cert(
      api_key: api_key,
      development: false,
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      development: false,
    )

    # This fastlane version publishes the profile details through lane_context
    # (SIGH_NAME / SIGH_UUID) and sets no sigh_* environment variables, so read
    # them from there. Fall back to the UUID, which
    # PROVISIONING_PROFILE_SPECIFIER also accepts.
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_name = lane_context[SharedValues::SIGH_UUID] if profile_name.to_s.empty?

    if profile_name.to_s.empty?
      UI.important("lane_context keys: #{lane_context.keys.join(', ')}")
      UI.user_error!("Could not determine the provisioning profile from sigh")
    end
    UI.message("Using provisioning profile: #{profile_name}")

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "ios/App/App.xcodeproj",
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        signingStyle: "manual",
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
        "CODE_SIGN_STYLE=Manual",
        %(PROVISIONING_PROFILE_SPECIFIER="#{profile_name}"),
        %(CODE_SIGN_IDENTITY="Apple Distribution"),
      ].join(" "),
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end

require "securerandom"

default_platform(:ios)

APP_IDENTIFIER = "com.makeupbestie.app".freeze

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # APP_STORE_CONNECT_KEY_CONTENT may hold either the raw .p8 PEM text or a
    # base64 blob, so normalise it before use.
    raw_key = ENV["APP_STORE_CONNECT_KEY_CONTENT"].to_s.strip
    key_pem = raw_key.include?("BEGIN") ? raw_key : raw_key.unpack1("m")

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_pem,
      is_key_content_base64: false,
    )

    # A GitHub Actions runner is destroyed after every run, so the private key
    # that `cert` generates alongside a certificate is lost with it. That made
    # each run create a brand new distribution certificate until Apple's limit
    # of two was reached, leaving two unusable certificates behind.
    #
    # match stores the certificate *and its private key*, encrypted, in a
    # private git repo, so every run reuses the same signing identity and no
    # new certificates are ever created.
    #
    # A throwaway keychain is created for the runner because the default login
    # keychain on CI is locked and cannot accept an imported private key.
    keychain_name = "makeup-bestie-ci.keychain-db"
    keychain_password = SecureRandom.hex(20)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "main",
      storage_mode: "git",
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      readonly: false,
    )

    # Where match reports the profile name has moved between fastlane versions,
    # so try each known location rather than assuming one.
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    profile_name = mapping[APP_IDENTIFIER] if mapping.respond_to?(:[])
    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] if profile_name.to_s.empty?
    profile_name = lane_context[SharedValues::SIGH_NAME] if profile_name.to_s.empty?

    if profile_name.to_s.empty?
      UI.important("lane_context keys: #{lane_context.keys.join(', ')}")
      UI.important("sigh_* env keys: #{ENV.keys.grep(/\Asigh_/).join(', ')}")
      UI.user_error!("match did not report a provisioning profile for #{APP_IDENTIFIER}")
    end
    UI.message("Using provisioning profile: #{profile_name}")

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "ios/App/App.xcodeproj",
    )

    # Configure distribution signing on the app target only. Command-line
    # signing overrides are inherited by Swift package dependencies, whose
    # resource bundles do not support provisioning profiles.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"],
      build_configurations: ["Release"],
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        signingStyle: "manual",
      },
      # Keep the provisioning profile scoped to the app in export_options.
      # Passing it through xcargs applies it to every dependency target too,
      # including RevenueCat resource bundles that cannot be provisioned.
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
